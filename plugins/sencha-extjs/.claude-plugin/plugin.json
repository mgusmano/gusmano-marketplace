{
  "$schema": "https://anthropic.com/claude-code/plugin.schema.json",
  "name": "sencha-extjs",
  "version": "0.14.0",
  "description": "Sencha Ext JS Claude Code Mod",
  "types": "./types/index.d.ts",
  "author": {
    "name": "Marc Gusmano",
    "email": "mgusmano@yahoo.com"
  },
  "skills": [
    "./"
  ],
  "mcpServers": {
    "extjs-tools": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/ExtJSToolsMCPServer.mjs"
      ],
      "env": {}
    },
    "extjs-example": {
      "type": "stdio",
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/mcp/ExtJSExampleMCPServer.mjs"
      ],
      "env": {}
    }
  },
  "lspServers": "./.lsp.json"
}