{
  "modules": [
    "register.tsx"
  ],
  "hooks": {
    "SessionStart": [
      { "hooks": [{ 
        "type": "command", 
        "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/generic/handler.mjs\" session.start" }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/generic/handler.mjs\" session.end" }] }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/generic/handler.mjs\" turn.start" }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/generic/handler.mjs\" turn.end" }] }
    ],
    "PreToolUse": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/generic/handler.mjs\" tool.before" }] }
    ],
    "PostToolUse": [
      { "hooks": [{ "type": "command", "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/generic/handler.mjs\" tool.after" }] }
    ]
  }
}